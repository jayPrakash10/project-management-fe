# Base URL of the TaskFlow API, without a trailing slash.
# Endpoints are mounted at the root, e.g. ${VITE_API_URL}/auth/login
VITE_API_URL=http://localhost:3000

# true  -> always use the in-browser mock API (MSW); the real API is never called.
VITE_USE_MOCKS=false

# true  -> if GET /health fails at startup, fall back to the mock API automatically
#          and show a "Demo data" banner. Set to false to always show connection errors.
VITE_MOCK_FALLBACK=true
